# =========================================================================
# LingCraft-Release · 官方公开发布门户 Git 忽略规则 (.gitignore)
# =========================================================================

# 1. 严格禁止源代码与开发模块进入公开仓库（源码仅保存在官方私有库）
*.py
*.js
*.css
*.html
*.bat
*.vbs
modules/
static/
license_server/
license_tool/

# 2. 严格禁止私密凭据、卡密私钥与运行时配置入库
*.pem
*.key
*.dat
*.env
data/
license.dat
online_license.json

# 3. 本地构建与打包临时产物
__pycache__/
*.py[cod]
build/
dist/
release/
*.spec
*.log
*.tmp
*.zip
*.tar.gz

# 4. 操作系统与编辑器临时文件
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
